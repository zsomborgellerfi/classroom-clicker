# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classroom_clicker?schema=public"

# Auth / security
JWT_SECRET="your_secure_random_secret_here"

# Bootstrap admin user (used by prisma seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"

# Frontend URLs (used for socket + password reset links)
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# SMTP (optional in dev; DISABLE_EMAIL=true skips sending)
EMAIL_FROM="Classroom Clicker <no-reply@classroomclicker.local>"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
DISABLE_EMAIL=true

# Dev convenience
EXPOSE_RESET_TOKEN=true
